---
export const prerender = true;
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TexteLong from '../../components/TexteLong.astro';
import hero from '../../assets/hero.jpg';
---
<Base title="Galerie optimisée : images légères et polices" description="Une galerie dont les images sont redimensionnées par Astro et dont la police est affichée sans bloquer le texte.">
  <h1>Galerie optimisée</h1>
  <Image src={hero} alt="Salle de formation vue d'ensemble" widths={[400, 800]} sizes="400px" />
  <TexteLong sujet="de la galerie" complement="sur le poids des images" />
</Base>
