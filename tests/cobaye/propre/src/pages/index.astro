---
export const prerender = true;
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/hero.jpg';
import { paragraphes } from '../data/texte';
import { formations } from '../data/formations';
---
<Base title="Cobaye Formation : formations no-code et IA finançables" description="Formations no-code et IA à distance, finançables CPF et OPCO, avec un projet réel accompagné de A à Z.">
  <Image src={hero} alt="Atelier de formation no-code en petit groupe" layout="full-width" priority />
  <h1>Formations no-code et IA</h1>
  <h2>Pourquoi choisir nos formations ?</h2>
  {paragraphes('no-code et IA').slice(0, 3).map((p) => <p>{p}</p>)}
  <h2>Nos formations</h2>
  <ul>{formations.map((f) => <li><a href={`/formations/${f.slug}`}>{f.titre}</a></li>)}</ul>
</Base>
