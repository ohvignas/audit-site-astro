---
interface Props { title: string }
const { title } = Astro.props;
const canonicalURL = Astro.url.href; // C11
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Page dont la canonical est construite depuis Astro.url.href." />
    <link rel="canonical" href={canonicalURL} />
  </head>
  <body><main><slot /></main></body>
</html>
